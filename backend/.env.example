# Copy to backend/.env for running the backend or CLI from source.
# The desktop app does NOT use this file: enter your key in the app's Settings
# screen instead (it is stored encrypted on your machine, never in the installer).

LLM_PROVIDER=groq            # groq | gemini
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional
# DOCLAMAR_HOME=~/.doclamar        # where the index and chat history live
# DOCLAMAR_MAX_FILE_MB=100         # skip files larger than this
