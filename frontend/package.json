{
  "name": "doclamar",
  "productName": "DocLamar",
  "description": "Ask questions about your own documents, locally indexed.",
  "author": "Shlok Salgaonkar",
  "private": true,
  "version": "3.1.0",
  "type": "module",
  "main": "main.js",
  "scripts": {
    "dev": "vite",
    "start": "electron .",
    "electron-dev": "concurrently -k -n vite,electron \"npm:dev\" \"npm:start\"",
    "build": "vite build",
    "dist": "vite build && electron-builder",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "build": {
    "appId": "com.shlok.doclamar",
    "productName": "DocLamar",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "main.js",
      "preload.cjs",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../backend/dist/doclamar-backend",
        "to": "doclamar-backend"
      }
    ],
    "mac": {
      "target": [
        "dir"
      ]
    },
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "concurrently": "^9.2.1",
    "electron": "^38.0.0",
    "electron-builder": "^26.0.12",
    "eslint": "^9.33.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "katex": "^0.19.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "vite": "^7.1.2"
  }
}
